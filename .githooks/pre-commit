#!/bin/sh

echo "Checking Prettier formatting..."
yarn format:check

if [ $? -ne 0 ]; then
  echo "Prettier check failed. Run yarn format before committing."
  exit 1
fi

echo "Building frontend..."
yarn workspace @gencontent/frontend build

if [ $? -ne 0 ]; then
  echo "Frontend build failed. Commit cancelled."
  exit 1
fi
