NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://your-frontend-url
JSON_BODY_LIMIT=15mb

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/gencontent-studio
AUTH_TOKEN_SECRET=replace-with-a-long-random-production-secret
AUTH_TOKEN_EXPIRES_IN_SECONDS=604800
PASSWORD_RESET_EXPIRES_IN_MINUTES=5
EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=5

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
